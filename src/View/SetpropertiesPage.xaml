<Page x:Class="Lolchicer.Umlsql.View.SetpropertiesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:umlsql="clr-namespace:Lolchicer.Umlsql"
      xmlns:local="clr-namespace:Lolchicer.Umlsql.View"
      xmlns:viewmodel="clr-namespace:Lolchicer.Umlsql.ViewModel"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SetpropertiesPage">
    <Page.Resources>
        <CollectionViewSource
            Source="{Binding Source={StaticResource Setproperties}}"
            x:Key="listingDataView" />
    </Page.Resources>
    <StackPanel>
        <Label FontSize="32">Setproperties</Label>
        <Border BorderBrush="Gray" BorderThickness="2" />
        <ListBox ItemsSource="{Binding Source={StaticResource listingDataView}}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding Path=Id}" Click="NavigateSetpropertyPage"></Button>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border BorderBrush="Gray" BorderThickness="2" />
    </StackPanel>
</Page>
