<Page x:Class="Lolchicer.Umlsql.View.GetpropertyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Lolchicer.Umlsql.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="GetpropertyPage">
    <StackPanel DataContext="{DynamicResource Getproperty}">
        <Label FontSize="32">Getproperty</Label>
        <Border BorderBrush="Gray" BorderThickness="2" />
        <Grid Grid.Row="1" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Name:" Grid.Row="0" Margin="0,0,10,0" />
            <TextBlock Text="Interface:" Grid.Row="1" Margin="0,0,10,0" />
            <TextBlock Text="Type:" Grid.Row="2" Margin="0,0,10,0" />

            <TextBlock Text="{Binding Id}" Grid.Row="0" Grid.Column="1" />
            <TextBlock Text="{Binding Interface}" Grid.Row="1" Grid.Column="1" />
            <TextBlock Text="{Binding Type}" Grid.Row="2" Grid.Column="1" />
        </Grid>

        <Border BorderBrush="Gray" BorderThickness="2" />

        <StackPanel Margin="5,10" Orientation="Horizontal">
            <TextBlock Text="Change Name:" Margin="0,0,10,0" />
            <TextBox Text="{Binding Id, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=C0}" Width="100" />
        </StackPanel>
    </StackPanel>
</Page>
