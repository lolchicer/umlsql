<Page x:Class="Lolchicer.Umlsql.View.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Lolchicer.Umlsql.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProductPage">
    <StackPanel>
        <Label FontSize="32">Product</Label>
        <Border BorderBrush="Gray" BorderThickness="2" />
        <Button Content="Interfaces" Click="NavigateInterfacesPage" />
        <Button Content="Setproperties" Click="NavigateSetpropertiesPage" />
        <Button Content="Getproperties" Click="NavigateGetpropertiesPage" />
        <Button Content="Arguments" Click="NavigateArgumentsPage" />
    </StackPanel>
</Page>
