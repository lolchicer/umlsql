<Page x:Class="Lolchicer.Umlsql.View.RowsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:umlsql="clr-namespace:Lolchicer.Umlsql"
      xmlns:local="clr-namespace:Lolchicer.Umlsql.View"
      xmlns:viewmodel="clr-namespace:Lolchicer.Umlsql.ViewModel"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RowsPage">
    <StackPanel>
        <Label FontSize="32">Rows</Label>
        <Border BorderBrush="Gray" BorderThickness="2" />

        <StackPanel x:Name="IdPanel"></StackPanel>
        <Border BorderBrush="Gray" BorderThickness="2" />

        <Button Content="Row" Click="NavigateRowPage" />
        <Button Content="New" Click="CreateNewRow" />
    </StackPanel>
</Page>
