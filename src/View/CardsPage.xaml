<Page x:Class="Lolchicer.Umlsql.View.CardsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:umlsql="clr-namespace:Lolchicer.Umlsql"
      xmlns:local="clr-namespace:Lolchicer.Umlsql.View"
      xmlns:viewmodel="clr-namespace:Lolchicer.Umlsql.ViewModel"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CardsPage">
    <StackPanel>
        <Label FontSize="32">Cards</Label>
        <Border BorderBrush="Gray" BorderThickness="2" />

        <StackPanel x:Name="IdPanel"></StackPanel>
        <Border BorderBrush="Gray" BorderThickness="2" />

        <Button Content="Card" Click="NavigateCardPage" />
        <Button Content="New" Click="CreateNewCard" />
    </StackPanel>
</Page>
