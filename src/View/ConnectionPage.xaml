<Page x:Class="Lolchicer.Umlsql.View.ConnectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Lolchicer.Umlsql.View"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ConnectionPage">
    <StackPanel DataContext="{StaticResource ConnectionContext}">
        <Label FontSize="32">Connection Context</Label>
        <Border BorderBrush="Gray" BorderThickness="2" />
        <Grid Grid.Row="1" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="ConnectionString:" Grid.Row="0" Margin="0,0,10,0" />

            <TextBlock Text="{Binding ConnectionString}" Grid.Row="0" Grid.Column="1" />

            <Button x:Name="button" Content="Product" HorizontalAlignment="Center" Height="36" Margin="0,194,0,0" VerticalAlignment="Top" Width="54" Click="NavigateProductPage"/>
            <Button Content="Save" HorizontalAlignment="Center" Margin="0,153,0,0" VerticalAlignment="Top" Height="36" Width="54" Click="SaveConnectionString"/>
        </Grid>

        <Border BorderBrush="Gray" BorderThickness="2" />

        <StackPanel Margin="5,10" Orientation="Horizontal">
            <TextBlock Text="Change ConnectionString:" Margin="0,0,10,0" />
            <TextBox Text="{Binding ConnectionString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=C0}" Width="600" />
        </StackPanel>
    </StackPanel>
</Page>
