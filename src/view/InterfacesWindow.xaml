<Window x:Class="Lolchicer.Umlsql.View.InterfacesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:umlsql="clr-namespace:Lolchicer.Umlsql"
        xmlns:local="clr-namespace:Lolchicer.Umlsql.View"
        xmlns:viewmodel="clr-namespace:Lolchicer.Umlsql.ViewModel"
        mc:Ignorable="d"
        Title="InterfacesWindow" Height="450" Width="800">
    <Window.Resources>
        <CollectionViewSource
            Source="{Binding Source={StaticResource Interfaces}}"
            x:Key="listingDataView" />
    </Window.Resources>
    <StackPanel>
        <Label FontSize="32">Interfaces</Label>
        <Border BorderBrush="Gray" BorderThickness="2" />
        <ListBox ItemsSource="{Binding Source={StaticResource listingDataView}}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding Path=Id}" Click="InterfaceShow"></Button>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border BorderBrush="Gray" BorderThickness="2" />
    </StackPanel>
</Window>
