<Window x:Class="Lolchicer.Umlsql.View.InterfaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lolchicer.Umlsql.View"
        mc:Ignorable="d"
        Title="Interface" Height="450" Width="800">
    <Window.Resources>
        <local:Interface x:Key="InterfaceExample" Name="Example" />
    </Window.Resources>
    <StackPanel DataContext="{StaticResource InterfaceExample}">
        <Label FontSize="32">Interface</Label>
        <Border BorderBrush="Gray" BorderThickness="2" />
        <Grid Grid.Row="1" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Name:" Grid.Row="0" Margin="0,0,10,0" />

            <TextBlock Text="{Binding Name}" Grid.Row="0" Grid.Column="1" />
        </Grid>

        <Border BorderBrush="Gray" BorderThickness="2" />
        
        <StackPanel Margin="5,10" Orientation="Horizontal">
            <TextBlock Text="Change Name:" Margin="0,0,10,0" />
            <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=C0}" Width="100" />
        </StackPanel>
    </StackPanel>
</Window>
