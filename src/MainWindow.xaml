<Window x:Class="Lolchicer.Umlsql.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lolchicer.Umlsql"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <local:ConnectionContext x:Key="ConnectionContextMain" ConnectionString="Host=localhost;Port=5432;Database=usersdb;Username=username;Password=password" />
    </Window.Resources>
    <StackPanel DataContext="{StaticResource ConnectionContextMain}">
        <Label FontSize="32">Connection Context</Label>
        <Border BorderBrush="Gray" BorderThickness="2" />
        <Grid Grid.Row="1" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="ConnectionString:" Grid.Row="0" Margin="0,0,10,0" />

            <TextBlock Text="{Binding ConnectionString}" Grid.Row="0" Grid.Column="1" />
        </Grid>

        <Border BorderBrush="Gray" BorderThickness="2" />
        
        <StackPanel Margin="5,10" Orientation="Horizontal">
            <TextBlock Text="Change ConnectionString:" Margin="0,0,10,0" />
            <TextBox Text="{Binding ConnectionString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=C0}" Width="600" />
        </StackPanel>
    </StackPanel>
</Window>
