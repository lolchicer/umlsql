<Window x:Class="Lolchicer.Umlsql.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lolchicer.Umlsql"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Button x:Name="button" Content="Button" HorizontalAlignment="Center" Height="36" Margin="0,194,0,0" VerticalAlignment="Top" Width="54" Click="button_Click"/>
        <StackPanel DataContext="{StaticResource ConnectionContextMain}">
            <Label FontSize="32">Connection Context</Label>
            <Border BorderBrush="Gray" BorderThickness="2" />
            <Grid Grid.Row="1" Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="ConnectionString:" Grid.Row="0" Margin="0,0,10,0" />

                <TextBlock Text="{Binding ConnectionString}" Grid.Row="0" Grid.Column="1" />
            </Grid>
            <StackPanel Margin="5,10" Orientation="Horizontal">
                <TextBlock x:Name="ConnectionBlock" Text="Change ConnectionString:" Margin="0,0,10,0" />
                <TextBox x:Name="ConnectionBox" Width="600" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
